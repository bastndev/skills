---
interface Props {
  href: string;
  text: string;
}

const { href, text } = Astro.props;
---

<a href={href} class="back-btn">
  ← {text}
</a>

<style>
  .back-btn {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.95rem;
    color: var(--color-bg);
    background-color: #2d2d2d;
    text-decoration: none;
    border-radius: 15px;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    font-family: inherit;
  }

  :global([data-theme='dark']) .back-btn {
    background-color: #f5f5f5;
    color: #111111;
  }

  .back-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .back-btn:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }
</style>
